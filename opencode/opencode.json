{
  "$schema": "https://opencode.ai/config.json",
  "model": "github-copilot/claude-sonnet-5",
  "small_model": "github-copilot/gpt-5-mini",
  "provider": {
    "github-copilot": {},
    "anthropic": {
      "options": {
        "timeout": 600000
      }
    }
  },
  "instructions": ["AGENTS.md"],
  "permission": {
    "read": {
      "*": "allow",
      ".env": "deny",
      ".env.*": "deny",
      "**/.env": "deny",
      "**/.env.*": "deny",
      "**/*.pem": "deny",
      "**/*.key": "deny",
      "**/*.p12": "deny",
      "**/*.pfx": "deny",
      "**/*_rsa": "deny",
      "**/*_dsa": "deny",
      "**/*_ecdsa": "deny",
      "**/*_ed25519": "deny",
      "**/*.tfvars": "deny",
      "secrets/**": "deny",
      "**/secrets/**": "deny",
      "~/.ssh/**": "deny",
      "~/.aws/**": "deny",
      "~/.config/gh/**": "deny"
    },
    "edit": "allow",
    "webfetch": "allow",
    "bash": "ask"
  },
  "autoupdate": false,
  "share": "disabled"
}

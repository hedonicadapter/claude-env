{
  "model": "opus[1m]",
  "effortLevel": "xhigh",
  "outputStyle": "Terse",
  "permissions": {
    "allow": [
      "Bash(rtk ls *)",
      "Bash(rtk grep *)"
    ]
  },
  "extraKnownMarketplaces": {
    "official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "severity1": {
      "source": {
        "source": "github",
        "repo": "severity1/severity1-marketplace"
      }
    }
  },
  "enabledPlugins": {
    "code-simplifier@official": true,
    "prompt-improver@severity1": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "command -v rtk >/dev/null 2>&1 || exit 0; out=$(rtk hook claude 2>/dev/null) || exit 0; printf '%s' \"$out\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_CONFIG_DIR:-$HOME/.claude}/scripts/track-edits.py\"",
            "async": true
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_CONFIG_DIR:-$HOME/.claude}/scripts/self-update.sh\"",
            "async": true
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_CONFIG_DIR:-$HOME/.claude}/scripts/notify.sh\" notification 'Claude Code needs your attention'",
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_CONFIG_DIR:-$HOME/.claude}/scripts/notify.sh\" stop 'Your turn'",
            "async": true
          }
        ]
      }
    ]
  }
}
